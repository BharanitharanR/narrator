{
  "$defs": {
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "narrate": {
          "title": "Narrate",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "narrate",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DialogueTurn": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "style": {
          "default": "",
          "maxLength": 200,
          "title": "Style",
          "type": "string"
        },
        "tone": {
          "default": "neutral",
          "enum": [
            "neutral",
            "friendly",
            "confident",
            "energetic",
            "calm",
            "formal"
          ],
          "title": "Tone",
          "type": "string"
        },
        "pace": {
          "default": "normal",
          "enum": [
            "slow",
            "normal",
            "brisk"
          ],
          "title": "Pace",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text"
      ],
      "title": "DialogueTurn",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "semantic_timeline",
            "event",
            "moment",
            "edit_point",
            "screen_text",
            "action",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "timestamp_seconds": {
          "minimum": 0,
          "title": "Timestamp Seconds",
          "type": "number"
        },
        "detail": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "source",
        "timestamp_seconds",
        "detail"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "NarrationSegment": {
      "additionalProperties": false,
      "properties": {
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "visual_action": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Visual Action",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrationText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DialogueTurn"
              },
              "maxItems": 12,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "estimated_speech_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Speech Seconds",
          "type": "number"
        },
        "fit_status": {
          "default": "fits",
          "enum": [
            "fits",
            "tight",
            "too_long",
            "no_voice",
            "needs_review"
          ],
          "title": "Fit Status",
          "type": "string"
        },
        "review_reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Reason"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "visual_action",
        "confidence"
      ],
      "title": "NarrationSegment",
      "type": "object"
    },
    "NarrationText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "introduce",
            "explain_action",
            "explain_result",
            "transition",
            "summarize",
            "warn",
            "context"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "tone": {
          "default": "neutral",
          "enum": [
            "neutral",
            "friendly",
            "confident",
            "energetic",
            "calm",
            "formal"
          ],
          "title": "Tone",
          "type": "string"
        },
        "pace": {
          "default": "normal",
          "enum": [
            "slow",
            "normal",
            "brisk"
          ],
          "title": "Pace",
          "type": "string"
        }
      },
      "required": [
        "text",
        "purpose"
      ],
      "title": "NarrationText",
      "type": "object"
    },
    "NoVoiceWindow": {
      "additionalProperties": false,
      "properties": {
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "reason": {
          "enum": [
            "original_speech",
            "important_visual",
            "reading_time",
            "transition",
            "ambient_audio",
            "no_narration_needed",
            "unknown"
          ],
          "title": "Reason",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 300,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "reason"
      ],
      "title": "NoVoiceWindow",
      "type": "object"
    },
    "Speaker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "maxLength": 120,
          "title": "Role",
          "type": "string"
        },
        "voice": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Voice",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "voice"
      ],
      "title": "Speaker",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "video_type": {
      "enum": [
        "demo",
        "tutorial",
        "walkthrough",
        "presentation",
        "documentation",
        "screen_recording",
        "vlog",
        "conversation",
        "gameplay",
        "review",
        "advertisement",
        "real_world",
        "music_video",
        "animation",
        "news",
        "meeting",
        "mixed",
        "unknown"
      ],
      "title": "Video Type",
      "type": "string"
    },
    "classification_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Classification Confidence",
      "type": "number"
    },
    "title": {
      "default": "Untitled narration",
      "maxLength": 160,
      "title": "Title",
      "type": "string"
    },
    "recommendation": {
      "enum": [
        "recommended",
        "optional",
        "not_recommended",
        "needs_review"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "mode": {
      "default": "single",
      "enum": [
        "single",
        "dialogue"
      ],
      "title": "Mode",
      "type": "string"
    },
    "speakers": {
      "items": {
        "$ref": "#/$defs/Speaker"
      },
      "maxItems": 2,
      "title": "Speakers",
      "type": "array"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "language": {
      "default": "en",
      "maxLength": 32,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "audience": {
      "default": "general",
      "maxLength": 120,
      "title": "Audience",
      "type": "string"
    },
    "overall_tone": {
      "default": "friendly",
      "enum": [
        "neutral",
        "friendly",
        "confident",
        "energetic",
        "calm",
        "formal"
      ],
      "title": "Overall Tone",
      "type": "string"
    },
    "target_words_per_minute": {
      "default": 145,
      "maximum": 240,
      "minimum": 80,
      "title": "Target Words Per Minute",
      "type": "integer"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/NarrationSegment"
      },
      "maxItems": 1000,
      "title": "Segments",
      "type": "array"
    },
    "no_voice_windows": {
      "items": {
        "$ref": "#/$defs/NoVoiceWindow"
      },
      "maxItems": 500,
      "title": "No Voice Windows",
      "type": "array"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Review Notes",
      "type": "array"
    },
    "source_analysis": {
      "default": "analysis.json",
      "title": "Source Analysis",
      "type": "string"
    }
  },
  "required": [
    "video_type",
    "classification_confidence",
    "recommendation",
    "duration_seconds"
  ],
  "title": "NarrationPlan 1.1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Narration plan. 1.1 adds mode, speakers, decision and dialogue turns; 1.0 files still validate."
}
